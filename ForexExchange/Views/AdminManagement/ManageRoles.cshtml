@model List<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "مدیریت نقش‌ها";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-10">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">ایجاد نقش جدید</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateRole" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="roleName" class="form-label">نام نقش</label>
                        <input type="text" class="form-control" id="roleName" name="roleName" required placeholder="مثال: Supervisor, Accountant" />
                        <div class="form-text">نام نقش باید منحصربه‌فرد باشد.</div>
                    </div>
                    <button type="submit" class="btn btn-primary">ایجاد نقش</button>
                </form>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">نقش‌های موجود</h5>
                <small class="text-white-50">@(Model?.Count ?? 0) نقش</small>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>نام نقش</th>
                                    <th class="text-center">کاربران</th>
                                    <th class="text-center">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var role in Model)
                                {
                                    var isProtected = role.Name == "Programmer" || role.Name == "Admin" || role.Name == "Customer";
                                    <tr class="@(isProtected ? "table-warning" : "")">
                                        <td class="fw-medium">
                                            @if (isProtected)
                                            {
                                                <span class="badge bg-warning text-dark me-2" title="این نقش قابل ویرایش/حذف نیست">🔒</span>
                                            }
                                            @role.Name
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary user-count-badge" data-role-id="@role.Id" data-role-name="@role.Name">
                                                <span class="count">...</span>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                @if (!isProtected)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary" onclick="editRole('@role.Id', '@role.Name')" title="ویرایش نام نقش">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger" onclick="confirmDeleteRole('@role.Id', '@role.Name')" title="حذف نقش">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                                <a asp-action="ManageRolePermissions" asp-route-roleName="@role.Name" class="btn btn-outline-primary" title="مدیریت دسترسی‌ها">
                                                    <i class="fas fa-user-lock"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                        <p class="text-muted">هیچ نقشی یافت نشد.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="EditRole" method="post" id="editRoleForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" id="editRoleId" />
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="fas fa-edit me-2"></i>ویرایش نام نقش</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editRoleName" class="form-label">نام جدید نقش</label>
                        <input type="text" class="form-control" id="editRoleName" name="roleName" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Role Confirmation Modal -->
<div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <form asp-action="DeleteRole" method="post" id="deleteRoleForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" id="deleteRoleId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>تأیید حذف</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>آیا از حذف نقش <strong id="deleteRoleNameDisplay"></strong> اطمینان دارید؟</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">بله، حذف شود</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function editRole(roleId, roleName) {
            document.getElementById('editRoleId').value = roleId;
            document.getElementById('editRoleName').value = roleName;
            new bootstrap.Modal(document.getElementById('editRoleModal')).show();
        }

        function confirmDeleteRole(roleId, roleName) {
            document.getElementById('deleteRoleId').value = roleId;
            document.getElementById('deleteRoleNameDisplay').textContent = roleName;
            new bootstrap.Modal(document.getElementById('deleteRoleModal')).show();
        }

        function loadUserCounts() {
            document.querySelectorAll('.user-count-badge').forEach(function(badge) {
                var roleId = badge.getAttribute('data-role-id');
                var roleName = badge.getAttribute('data-role-name');
                fetch('/AdminManagement/GetRoleUserCount?roleName=' + encodeURIComponent(roleName))
                    .then(function(response) { return response.json(); })
                    .then(function(count) {
                        badge.querySelector('.count').textContent = count;
                        badge.classList.remove('bg-secondary');
                        badge.classList.add(count > 0 ? 'bg-warning' : 'bg-success');
                    })
                    .catch(function() {
                        badge.querySelector('.count').textContent = '?';
                    });
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadUserCounts();
        });
    </script>
}
