@model ForexExchange.Models.Currency
@{
    ViewData["Title"] = "ویرایش ارز";
    var hasLogo = CurrencyHelper.IsImageSymbol(Model.Symbol);
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">ویرایش ارز #@Model.Id</h4>
                    <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Code" class="form-label">کد</label>
                                <input asp-for="Code" class="form-control" maxlength="4" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Name" class="form-label">نماد پرچم</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PersianName" class="form-label">نام فارسی</label>
                                <input asp-for="PersianName" class="form-control" />
                                <span asp-validation-for="PersianName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">لوگو / نماد</label>
                                <input type="file" name="logoFile" id="logoFile" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" />
                                <span asp-validation-for="Symbol" class="text-danger"></span>
                                <div class="form-text">حداکثر ۱۰۰ کیلوبایت — در صورت عدم انتخاب، لوگوی فعلی حفظ می‌شود.</div>
                                <div class="mt-2 d-flex align-items-center gap-3">
                                    <img id="logoPreview"
                                         src="@(hasLogo ? Model.Symbol : "")"
                                         alt="@Model.Code"
                                         style="height:40px;width:auto;@(hasLogo ? "" : "display:none;")" />
                                    @if (!hasLogo && !string.IsNullOrWhiteSpace(Model.Symbol))
                                    {
                                        <span class="text-muted">نماد فعلی: @Model.Symbol</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.Symbol))
                                {
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" name="clearLogo" value="true" id="clearLogo" />
                                        <label class="form-check-label" for="clearLogo">حذف لوگو / نماد</label>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">ترتیب و قدرت</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="ManageDisplayOrder" class="btn btn-outline-primary btn-sm">
                                        ترتیب نمایش: @Model.DisplayOrder
                                    </a>
                                    <a asp-action="ManageRatePriority" class="btn btn-outline-warning btn-sm">
                                        قدرت نرخ: @Model.RatePriority
                                    </a>
                                </div>
                                <div class="form-text">برای تغییر، از صفحات کشیدن و رها کردن استفاده کنید.</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">انصراف</a>
                            <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('logoFile')?.addEventListener('change', function (e) {
            const file = e.target.files?.[0];
            const preview = document.getElementById('logoPreview');
            if (!file || !preview) return;
            const reader = new FileReader();
            reader.onload = function (ev) {
                preview.src = ev.target.result;
                preview.style.display = 'inline-block';
            };
            reader.readAsDataURL(file);
        });
    </script>
}
