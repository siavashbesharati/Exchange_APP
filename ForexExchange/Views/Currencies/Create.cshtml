@model ForexExchange.Models.Currency
@{
    ViewData["Title"] = "افزودن ارز";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">افزودن ارز</h4>
                    <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Code" class="form-label">کد</label>
                                <input asp-for="Code" class="form-control" maxlength="4" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Name" class="form-label">نماد پرچم</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PersianName" class="form-label">نام فارسی</label>
                                <input asp-for="PersianName" class="form-control" />
                                <span asp-validation-for="PersianName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Symbol" class="form-label">نماد</label>
                                <input asp-for="Symbol" class="form-control" />
                                <span asp-validation-for="Symbol" class="text-danger"></span>
                            </div>
                            <div class="col-md-8 mb-3">
                                <div class="alert alert-light border mb-0 py-2">
                                    ترتیب نمایش و قدرت ارز بعد از ایجاد، از دکمه‌های
                                    <strong>ترتیب نمایش داشبورد</strong> و <strong>قدرت ارز</strong>
                                    در لیست ارزها قابل تنظیم است.
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">انصراف</a>
                            <button type="submit" class="btn btn-primary">ذخیره</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
